<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base style for every keypad cell: makes GridLayout weight the
         cell equally in both directions so it stays perfectly square/circular
         on any screen size (see dimensionRatio note on the GridLayout itself). -->
    <style name="PinKeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@drawable/bg_key_circle</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Number keys (0-9): centered bold digit -->
    <style name="PinKey" parent="PinKeyBase">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
