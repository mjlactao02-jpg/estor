<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="80dp"

    android:background="#FFFFFF"

    android:paddingStart="7dp"
    android:paddingEnd="7dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">


    <!-- ===================================================== -->
    <!-- DATE AND TIME                                        -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtTransactionDate"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="May 2, 2026 10:30PM"

        android:textColor="#555555"
        android:textSize="15sp"

        android:maxLines="1"
        android:ellipsize="end"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtTransactionAmount" />


    <!-- ===================================================== -->
    <!-- CUSTOMER NAME                                        -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtTransactionName"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="1dp"

        android:text="Mary Jane Parker"

        android:textColor="#222222"
        android:textSize="23sp"

        android:maxLines="1"
        android:ellipsize="end"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTransactionDate"
        app:layout_constraintEnd_toStartOf="@id/txtTransactionAmount" />


    <!-- ===================================================== -->
    <!-- TRANSACTION TYPE                                     -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtTransactionType"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="↓ Debt"
        android:textColor="#F05B5B"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTransactionName" />


    <!-- ===================================================== -->
    <!-- AMOUNT                                               -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtTransactionAmount"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-₱100.00"
        android:textColor="#FF0000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <!-- ===================================================== -->
    <!-- DIVIDER                                               -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/transactionDivider"

        android:layout_width="0dp"
        android:layout_height="1dp"

        android:background="#EEEEEE"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>