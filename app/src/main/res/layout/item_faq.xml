<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_input_field"
    android:backgroundTint="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtFaqQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Question?"
        android:textColor="#222222"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgFaqChevron"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgFaqChevron"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_chevron_right"
        android:rotation="0"
        app:tint="#BBBBBB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtFaqQuestion"
        app:layout_constraintBottom_toTopOf="@id/txtFaqAnswer" />

    <TextView
        android:id="@+id/txtFaqAnswer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Answer"
        android:textColor="#444444"
        android:textSize="16sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtFaqQuestion" />

</androidx.constraintlayout.widget.ConstraintLayout>
