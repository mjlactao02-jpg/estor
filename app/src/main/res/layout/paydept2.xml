<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#FFFFFF">


    <!-- ===================================================== -->
    <!-- HEADER - SAME STYLE AS ADDDEBT                        -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"

        android:layout_width="match_parent"
        android:layout_height="90dp"

        android:background="@drawable/bg_header"
        android:padding="12dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- BACK BUTTON                                       -->
        <!-- ================================================= -->

        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="45dp"
            android:layout_height="45dp"

            android:layout_marginTop="32dp"

            android:background="@android:color/transparent"

            android:contentDescription="Back"

            android:padding="10dp"

            android:src="@drawable/ic_arrow_back"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- ================================================= -->
        <!-- TITLE                                              -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Pay Dept"

            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"

            android:gravity="center"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- CUSTOMER + TOTAL DEBT CARD                            -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:minHeight="62dp"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp"
        android:paddingBottom="7dp"
        android:background="@drawable/bg_customer_paydept"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- CUSTOMER NAME                                     -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtCustomerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Juan Dela Cruz"
            android:textColor="#222222"
            android:textSize="25sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dividerVertical"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Juan Dela Cruz" />

        <!-- ================================================= -->
        <!-- CUSTOMER PHONE                                    -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtCustomerPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="0912 345 6789"
            android:textColor="#222222"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dividerVertical"
            app:layout_constraintTop_toBottomOf="@id/txtCustomerName"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="0912 345 6789" />


        <!-- ================================================= -->
        <!-- VERTICAL DIVIDER                                   -->
        <!-- ================================================= -->

        <View
            android:id="@+id/dividerVertical"

            android:layout_width="1dp"
            android:layout_height="0dp"

            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"

            android:background="#DDDDDD"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txtTotalDebt" />


        <!-- ================================================= -->
        <!-- TOTAL DEBT                                         -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtTotalDebt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱ 205.00"
            android:textColor="#F05B5B"
            android:textSize="25sp"
            android:textStyle="bold"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            tools:text="₱ 205.00" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- DEBT ITEM LISTVIEW                                    -->
    <!-- ===================================================== -->

    <ListView
        android:id="@+id/listViewDebt"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginStart="10dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"

        android:background="@android:color/transparent"

        android:clipToPadding="false"

        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"

        android:paddingStart="0dp"
        android:paddingTop="2dp"
        android:paddingEnd="0dp"
        android:paddingBottom="2dp"

        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"

        app:layout_constraintTop_toBottomOf="@id/customerCard"
        app:layout_constraintBottom_toTopOf="@id/paymentContainer"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- PAYMENT CONTAINER                                    -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/paymentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="3dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ================================================= -->
        <!-- AMOUNT TO PAY LABEL                               -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtAmountLabel"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Amount to pay"

            android:textColor="#444444"
            android:textSize="16dp"

            android:layout_marginBottom="4dp" />


        <!-- ================================================= -->
        <!-- AMOUNT INPUT                                      -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/edtAmountToPay"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center_vertical"
            android:inputType="numberDecimal"
            android:textColor="#222222"
            android:textSize="17dp"
            android:singleLine="true" />


        <!-- ================================================= -->
        <!-- HALF / FULL BUTTONS                               -->
        <!-- ================================================= -->

        <!-- ================================================= -->
        <!-- HALF / FULL BUTTONS                               -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">


            <!-- HALF -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHalf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Half"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:elevation="0dp"
                android:padding="0dp" />


            <!-- GAP -->

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />


            <!-- FULL -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFull"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Full"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="@null"
                android:elevation="0dp"
                android:padding="0dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PAY DEPT BUTTON                                   -->
        <!-- ================================================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPayDebt"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginTop="9dp"
            android:text="✓ Pay Dept"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:backgroundTint="@null"
            android:elevation="0dp"
            android:layout_marginBottom="20dp" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>