<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F9F9F9">


    <!-- ================================================= -->
    <!-- MAIN CONTENT                                      -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="50dp"
            android:paddingBottom="16dp">


            <!-- ================================================= -->
            <!-- TOTAL DEBT / WALLET                                -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_wallet"
                android:clipToOutline="true">


                <!-- ================================================= -->
                <!-- WALLET PICTURE                                   -->
                <!-- ================================================= -->

                <ImageView
                    android:id="@+id/imgWalletDecoration"
                    android:layout_width="155dp"
                    android:layout_height="155dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="-5dp"
                    android:src="@drawable/wallet"
                    android:alpha="0.15"
                    android:scaleType="centerInside"
                    android:contentDescription="Wallet decoration" />


                <!-- ================================================= -->
                <!-- WALLET CONTENT                                    -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="22dp">


                    <!-- ============================================= -->
                    <!-- SETTINGS                                       -->
                    <!-- ============================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">


                        <ImageButton
                            android:id="@+id/btnSettings"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:background="@android:color/transparent"
                            android:clickable="true"
                            android:contentDescription="Settings"
                            android:focusable="true"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_settings" />

                    </LinearLayout>


                    <!-- ============================================= -->
                    <!-- TOTAL DEBT LABEL                              -->
                    <!-- ============================================= -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Total debt:"
                        android:textColor="#DDE7FF"
                        android:textSize="20sp"
                        android:textStyle="bold" />


                    <!-- ============================================= -->
                    <!-- TOTAL DEBT AMOUNT                             -->
                    <!-- ============================================= -->

                    <TextView
                        android:id="@+id/txtBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:maxLines="1"
                        android:text="₱420.00"
                        android:textColor="#FFFFFF"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>


            <!-- ================================================= -->
            <!-- SUMMARY CARDS                                      -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- UNPAID CUSTOMER                                  -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="140dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_unpaid">


                    <!-- ============================================= -->
                    <!-- TITLE ROW                                    -->
                    <!-- ============================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <!-- ========================================= -->
                        <!-- BLANK CIRCLE + YOUR IMAGE                 -->
                        <!-- ========================================= -->

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_unpaid_icon">


                            <!--
                                PUT YOUR OWN ICON HERE

                                Example:
                                res/drawable/ic_unpaid_customer.png

                                You can replace the PNG with your
                                own image without changing this layout.
                            -->

                            <ImageView
                                android:id="@+id/imgUnpaidCustomer"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_unpaid_customer"
                                android:scaleType="centerInside"
                                android:contentDescription="Unpaid Customer icon" />

                        </FrameLayout>


                        <!-- ========================================= -->
                        <!-- TITLE                                     -->
                        <!-- ========================================= -->

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unpaid Customer"
                            android:textColor="#172033"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                    </LinearLayout>


                    <!-- ============================================= -->
                    <!-- CUSTOMER COUNT                                -->
                    <!-- ============================================= -->

                    <TextView
                        android:id="@+id/txtUnpaidCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0 Customers"
                        android:textColor="#D81B4E"
                        android:textSize="16sp" />


                    <!-- ============================================= -->
                    <!-- UNPAID AMOUNT                                 -->
                    <!-- ============================================= -->

                    <TextView
                        android:id="@+id/txtUnpaidAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="₱0.00"
                        android:textColor="#D81B4E"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- SPACE                                             -->
                <!-- ================================================= -->

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />


                <!-- ================================================= -->
                <!-- PARTIAL CUSTOMER                                  -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="140dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_partial">


                    <!-- ============================================= -->
                    <!-- TITLE ROW                                    -->
                    <!-- ============================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <!-- ========================================= -->
                        <!-- BLANK CIRCLE + YOUR IMAGE                 -->
                        <!-- ========================================= -->

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_partial_icon">


                            <!--
                                PUT YOUR OWN ICON HERE

                                Example:
                                res/drawable/ic_partial_customer.png

                                You can replace the PNG with your
                                own image without changing this layout.
                            -->

                            <ImageView
                                android:id="@+id/imgPartialCustomer"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_partial_customer"
                                android:scaleType="centerInside"
                                android:contentDescription="Partial Customer icon" />

                        </FrameLayout>


                        <!-- ========================================= -->
                        <!-- TITLE                                     -->
                        <!-- ========================================= -->

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Partial Customer"
                            android:textColor="#172033"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                    </LinearLayout>


                    <!-- ============================================= -->
                    <!-- CUSTOMER COUNT                                -->
                    <!-- ============================================= -->

                    <TextView
                        android:id="@+id/txtPartialCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0 Customers"
                        android:textColor="#149447"
                        android:textSize="16sp" />


                    <!-- ============================================= -->
                    <!-- PARTIAL AMOUNT                                 -->
                    <!-- ============================================= -->

                    <TextView
                        android:id="@+id/txtPartialAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="₱0.00"
                        android:textColor="#149447"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- OVERDUE CARD (fills free space, due-date feature) -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardOverdue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="110dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_overdue"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_overdue_icon">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calendar"
                            android:scaleType="centerInside"
                            android:contentDescription="Overdue icon" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overdue Debts"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#E58A00"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtOverdueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 Customers"
                    android:textColor="#E58A00"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtOverdueAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₱0.00"
                    android:textColor="#E58A00"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- DUE SOON (today / next) fills vertical space     -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardDueSoon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_input_field">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUE SOON"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <LinearLayout
                    android:id="@+id/dueSoonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtDueSoonEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="No dues soon — all clear!"
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ACTION BUTTONS ROW 1                               -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- ADD DEBT                                          -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/btnAddDebt"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_add_debt">


                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_white_circle"
                        android:elevation="4dp">


                        <ImageView
                            android:id="@+id/imgAddDebt"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_adddept"
                            android:contentDescription="Add Debt"
                            android:scaleType="centerInside" />

                    </FrameLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Add Debt"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- SPACE -->

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />


                <!-- ================================================= -->
                <!-- PAY DEBT                                          -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/btnPayDebt"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_add_debt">


                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_white_circle"
                        android:elevation="4dp">


                        <ImageView
                            android:id="@+id/imgPayDebt"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_paydept"
                            android:contentDescription="Pay Debt"
                            android:scaleType="centerInside" />

                    </FrameLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pay Debt"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ACTION BUTTONS ROW 2                               -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- TRANSACTION                                      -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/btnTransaction"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_add_debt">


                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_white_circle"
                        android:elevation="4dp">


                        <ImageView
                            android:id="@+id/imgTransaction"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_transaction"
                            android:contentDescription="Transaction"
                            android:scaleType="centerInside" />

                    </FrameLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Transaction"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- SPACE -->

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />


                <!-- ================================================= -->
                <!-- HISTORY                                           -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_add_debt">


                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_white_circle"
                        android:elevation="4dp">


                        <ImageView
                            android:id="@+id/imgHistory"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_history"
                            android:contentDescription="History"
                            android:scaleType="centerInside" />

                    </FrameLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="History"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>