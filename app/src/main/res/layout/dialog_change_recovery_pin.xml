<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="22dp"
    android:paddingBottom="24dp"

    android:background="@drawable/bg_recovery_dialog">


    <!-- ===================================================== -->
    <!-- TITLE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Change Recovery PIN"

        android:textColor="#111111"
        android:textSize="20sp"
        android:textStyle="bold"

        android:layout_marginBottom="16dp" />


    <!-- ===================================================== -->
    <!-- PREVIOUS RECOVERY PIN LABEL -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Previous Recovery PIN"

        android:textColor="#222222"
        android:textSize="14sp"

        android:layout_marginBottom="5dp" />


    <!-- ===================================================== -->
    <!-- PREVIOUS RECOVERY PIN -->
    <!-- ===================================================== -->

    <EditText
        android:id="@+id/editPreviousPin"

        android:layout_width="match_parent"
        android:layout_height="48dp"

        android:hint=""

        android:inputType="numberPassword"
        android:maxLength="4"

        android:textSize="16sp"
        android:textColor="#222222"

        android:background="@drawable/bg_recovery_input"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"

        android:importantForAutofill="no" />


    <!-- ===================================================== -->
    <!-- NEW RECOVERY PIN LABEL -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="New Recovery PIN"

        android:textColor="#222222"
        android:textSize="14sp"

        android:layout_marginTop="12dp"
        android:layout_marginBottom="5dp" />


    <!-- ===================================================== -->
    <!-- NEW RECOVERY PIN -->
    <!-- ===================================================== -->

    <EditText
        android:id="@+id/editNewPin"

        android:layout_width="match_parent"
        android:layout_height="48dp"

        android:inputType="numberPassword"
        android:maxLength="4"

        android:textSize="16sp"
        android:textColor="#222222"

        android:background="@drawable/bg_recovery_input"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"

        android:importantForAutofill="no" />


    <!-- ===================================================== -->
    <!-- CONFIRM NEW RECOVERY PIN LABEL -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Confirm New Recovery PIN"

        android:textColor="#222222"
        android:textSize="14sp"

        android:layout_marginTop="12dp"
        android:layout_marginBottom="5dp" />


    <!-- ===================================================== -->
    <!-- CONFIRM NEW RECOVERY PIN -->
    <!-- ===================================================== -->

    <EditText
        android:id="@+id/editConfirmPin"

        android:layout_width="match_parent"
        android:layout_height="48dp"

        android:inputType="numberPassword"
        android:maxLength="4"

        android:textSize="16sp"
        android:textColor="#222222"

        android:background="@drawable/bg_recovery_input"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"

        android:importantForAutofill="no" />


    <!-- ===================================================== -->
    <!-- SAVE BUTTON -->
    <!-- ===================================================== -->

    <Button
        android:id="@+id/btnSaveRecoveryPin"

        android:layout_width="match_parent"
        android:layout_height="48dp"

        android:layout_marginTop="16dp"

        android:text="Save"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="normal"

        android:background="@drawable/bg_recovery_save_button"
        android:textAllCaps="false" />

</LinearLayout>