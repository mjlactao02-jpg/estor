<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="65dp"

    android:background="#FFFFFF"

    android:paddingStart="8dp"
    android:paddingEnd="4dp">


    <!-- ===================================================== -->
    <!-- CUSTOMER NAME                                         -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtCustomerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mary Jane Parker"
        android:textColor="#222222"
        android:textSize="23sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/totalDebtContainer"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ===================================================== -->
    <!-- CUSTOMER PHONE                                        -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtCustomerPhone"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="09123456789"

        android:textColor="#555555"
        android:textSize="17sp"

        android:maxLines="1"

        android:layout_marginTop="2dp"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toStartOf="@id/totalDebtContainer"

        app:layout_constraintTop_toBottomOf="@id/txtCustomerName" />


    <!-- ===================================================== -->
    <!-- TOTAL DEBT                                            -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/totalDebtContainer"

        android:layout_width="90dp"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:gravity="center"

        app:layout_constraintEnd_toStartOf="@id/txtArrow"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent">


        <TextView
            android:id="@+id/txtTotalDebt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱ 0.00"
            android:textColor="#555555"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- RIGHT ARROW                                           -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtArrow"

        android:layout_width="20dp"
        android:layout_height="match_parent"

        android:text="›"

        android:textColor="#6E84EF"
        android:textSize="24sp"
        android:textStyle="bold"

        android:gravity="center"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>