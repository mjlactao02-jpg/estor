<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FFFFFF" />

    <!-- Rounded corners -->
    <corners android:radius="18dp" />

    <!-- Optional border -->
    <stroke
        android:width="1dp"
        android:color="#C9C9C9" />

    <!-- Optional padding -->
    <padding
        android:left="3dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="0dp" />

</shape>
