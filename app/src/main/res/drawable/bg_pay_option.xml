<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->

    <item
        android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid
                android:color="#EEEEEE" />

            <stroke
                android:width="1dp"
                android:color="#D6D6D6" />

            <corners
                android:radius="6dp" />

        </shape>

    </item>


    <!-- Normal -->

    <item>

        <shape android:shape="rectangle">

            <solid
                android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#D6D6D6" />

            <corners
                android:radius="6dp" />

        </shape>

    </item>

</selector>