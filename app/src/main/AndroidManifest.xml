<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================================= -->
    <!-- SMS PERMISSION                                            -->
    <!-- ========================================================= -->

    <uses-permission
        android:name="android.permission.SEND_SMS" />


    <!-- ========================================================= -->
    <!-- EXACT ALARM PERMISSION                                    -->
    <!-- Required for scheduled payment reminders                 -->
    <!-- ========================================================= -->

    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />


    <!-- ========================================================= -->
    <!-- BOOT PERMISSION                                           -->
    <!-- Allows reminders to be scheduled again after reboot      -->
    <!-- ========================================================= -->

    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />


    <!-- ========================================================= -->
    <!-- TELEPHONY IS OPTIONAL                                     -->
    <!-- ========================================================= -->

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />


    <!-- ========================================================= -->
    <!-- APPLICATION                                               -->
    <!-- ========================================================= -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Estor">


        <!-- ===================================================== -->
        <!-- SPLASH SCREEN                                         -->
        <!-- This is now the FIRST screen when the app opens       -->
        <!-- ===================================================== -->

        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- ===================================================== -->
        <!-- PIN ACTIVITY                                          -->
        <!-- ===================================================== -->

        <activity
            android:name=".PinActivity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- ADD DEBT                                              -->
        <!-- ===================================================== -->

        <activity
            android:name=".AdddeptActivity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- PAY DEBT                                              -->
        <!-- ===================================================== -->

        <activity
            android:name=".PaydeptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Paydept2Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ===================================================== -->
        <!-- TRANSACTIONS                                          -->
        <!-- ===================================================== -->

        <activity
            android:name=".TransactionActivity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- HISTORY                                               -->
        <!-- ===================================================== -->

        <activity
            android:name=".HistoryActivity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- HISTORY 2                                             -->
        <!-- ===================================================== -->

        <activity
            android:name=".History2Activity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- ADD DEBT 2                                            -->
        <!-- ===================================================== -->

        <activity
            android:name=".Adddept2Activity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- SETTINGS                                              -->
        <!-- ===================================================== -->

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- MAIN ACTIVITY                                         -->
        <!-- ===================================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- PAYMENT REMINDER RECEIVER                             -->
        <!-- ===================================================== -->

        <receiver
            android:name=".ReminderReceiver"
            android:enabled="true"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- BOOT RECEIVER                                         -->
        <!-- Re-schedules reminders after phone restart           -->
        <!-- ===================================================== -->

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>

                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />

            </intent-filter>

        </receiver>


    </application>

</manifest>